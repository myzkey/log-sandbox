{
  "name": "@alb-analyzer/ingest-cli",
  "version": "1.0.0",
  "type": "module",
  "description": "AWS Application Load Balancer (ALB) Log Analyzer CLI",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "bin": {
    "alb-log-analyzer": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc && tsc-alias",
    "download": "tsx src/scripts/download-and-analyze.ts",
    "import": "tsx src/scripts/import-to-db.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "keywords": [
    "alb",
    "log",
    "analyzer",
    "aws",
    "load-balancer"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@alb-analyzer/db": "workspace:*",
    "drizzle-orm": "^0.36.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.0.5",
    "@vitest/ui": "^4.0.5",
    "ts-node": "^10.9.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.0.0",
    "vitest": "^4.0.5"
  },
  "tsc-alias": {
    "resolveFullPaths": true,
    "replacers": {
      "exampleReplacer": {
        "enabled": false
      }
    }
  }
}
