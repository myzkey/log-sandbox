{
  "name": "alb-log-analyzer-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "AWS Application Load Balancer (ALB) Log Analyzer - Monorepo",
  "scripts": {
    "dev": "pnpm --filter @alb-analyzer/dashboard dev",
    "build": "pnpm -r build",
    "dev:dashboard": "pnpm --filter @alb-analyzer/dashboard dev",
    "download": "pnpm --filter @alb-analyzer/ingest-cli download",
    "download:force": "pnpm --filter @alb-analyzer/ingest-cli download -- --force",
    "refresh": "pnpm download:force && pnpm db:reset",
    "db:import": "pnpm --filter @alb-analyzer/ingest-cli exec tsx src/scripts/import-to-db.ts",
    "db:reset": "pnpm --filter @alb-analyzer/ingest-cli exec tsx src/scripts/import-to-db.ts --reset",
    "db:generate": "pnpm --filter @alb-analyzer/db db:generate",
    "db:migrate": "pnpm --filter @alb-analyzer/db db:migrate",
    "db:push": "pnpm --filter @alb-analyzer/db db:push",
    "db:studio": "pnpm --filter @alb-analyzer/db db:studio",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  },
  "keywords": [
    "alb",
    "log",
    "analyzer",
    "aws",
    "load-balancer"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitest/coverage-v8": "^4.0.5",
    "@vitest/ui": "^4.0.5",
    "eslint": "^9.38.0",
    "ts-node": "^10.9.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.0.0",
    "vitest": "^4.0.5"
  },
  "tsc-alias": {
    "resolveFullPaths": true,
    "replacers": {
      "exampleReplacer": {
        "enabled": false
      }
    }
  }
}
